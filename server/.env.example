PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/buildiqo
# Render / Cloud MongoDB URI (alternative):
MONGODB_URI=mongodb://localhost:27017/buildiqo
JWT_SECRET=your_long_random_jwt_secret_min_32_chars
FRONTEND_ORIGIN=https://buildiqo-frontend.onrender.com,http://localhost:3000
# Alternatively FRONTEND_URL is also supported:
# FRONTEND_URL=https://buildiqo-frontend.onrender.com
SEED_ADMIN_EMAIL=admin@buildiqo.ai
SEED_ADMIN_PASSWORD=your_secure_admin_seed_password_here

# Phase 3.5: AI-Assisted Regional Material Price Research Configuration
PRICE_RESEARCH_PROVIDER=google
PRICE_RESEARCH_MODEL=gemini-1.5-flash
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
PRICE_RESEARCH_MAX_MATERIALS=100
PRICE_RESEARCH_TIMEOUT_MS=30000
PRICE_RESEARCH_MAX_CONCURRENCY=3

# Floor Plan Extraction Microservice (Phase 1)
FLOORPLAN_SERVICE_URL=http://127.0.0.1:5001
FLOORPLAN_SERVICE_TIMEOUT_MS=15000
FLOORPLAN_SERVICE_TOKEN=your_secure_random_floorplan_service_token_here
FLOORPLAN_MAX_FILE_SIZE_MB=25

